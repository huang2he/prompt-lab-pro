# prompt-lab dispatcher config
#
# 用法：
#   1. 把本文件 cp 成 .env（同目录）
#   2. 填上 PROMPT_LAB_DISPATCHER_TOKEN（从 dispatcher 维护者拿）
#   3. URL 通常不用改；只有切换到新 dispatcher 实例时才改
#
# skill 启动时按以下优先级解析：
#   (1) 环境变量 PROMPT_LAB_DISPATCHER_URL / PROMPT_LAB_DISPATCHER_TOKEN（最高，适合 CI）
#   (2) ~/.claude/skills/prompt-lab/.env  （首次跑会问 token 并落盘）
#   (3) 这里的 .env.example 默认值（仅 URL）
#
# 安全提醒：.env 已被 .gitignore，不会提交到仓库；token 不要贴到聊天/截图

PROMPT_LAB_DISPATCHER_URL=http://47.100.137.178:8080
PROMPT_LAB_DISPATCHER_TOKEN=
